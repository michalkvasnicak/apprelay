# Local infrastructure only. Copy to .env at the repository root.
# Docker Compose reads this file's .env copy; the native Rust server does not.
# Use a local-only password; URL-encode it when constructing DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-only

# Defaults expose HTTPS only on this Mac.
APPRELAY_HTTPS_HOST=localhost
APPRELAY_HTTPS_BIND=127.0.0.1

# Native API as reached from the Caddy container in Colima.
APPRELAY_API_UPSTREAM=host.lima.internal:8080

# For a physical iPhone, change BOTH host and bind to the Mac's LAN IPv4,
# e.g. 192.168.1.42, and enable Colima network.hostAddresses (see infra/README.md).
