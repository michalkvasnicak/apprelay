# Public web build argument. Match EXPO_PUBLIC_APP_SCHEME in the iOS build.
VITE_APPRELAY_APP_SCHEME=apprelay

# Optional public build arguments. Set both to enable Umami analytics.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# Set the rest in Coolify as runtime variables, not build arguments.
# Create a dedicated AppRelay database/user on the EXISTING PostgreSQL server
# and create the Temporal namespace before deployment. Neither service is
# provisioned by this stack. Their existing persistence remains unchanged.
APPRELAY_DOCKER_NETWORK=coolify
DATABASE_URL=postgres://apprelay:URL_ENCODED_PASSWORD@postgres:5432/apprelay
APPRELAY_TEMPORAL_ADDRESS=http://temporal:7233
APPRELAY_TEMPORAL_NAMESPACE=apprelay

# Required public HTTPS origin for the anisette v3 API and browser WebSocket.
APPRELAY_ANISETTE_URL=

# This configuration assumes private-network Temporal without additional TLS
# or authentication settings; those are not wired into the current client.
# Keep both shared services private and reachable through the external network.

# Generate with openssl rand -hex 32. Set the identical value as
# EXPO_PUBLIC_API_KEY in the mobile build environment; never commit actual keys.
APPRELAY_API_KEY=

# Existing private Redis on the shared network; do not publicly publish its port.
REDIS_URL=redis://redis:6379/0
# Exact cloudflared TCP peer CIDRs as seen by the API (e.g. Docker host gateway /32).
# Trusted peers must provide CF-Connecting-IP. Never trust the VPN/client subnet.
APPRELAY_TRUSTED_PROXY_CIDRS=

# Generate once with openssl rand -base64 32; keep across deployments.
PAIRING_ENCRYPTION_KEY=

# These are ABSOLUTE paths on the Ubuntu Docker host, not repository paths.
# Generate the WireGuard key once with wg genkey, owner root, mode 0600.
# APNs .p8 file must be readable by container UID 10001 (owner 10001, mode 0600).
# Back up both keys and PAIRING_ENCRYPTION_KEY; never commit their contents.
APPRELAY_VPN_PRIVATE_KEY_HOST_FILE=/data/apprelay/secrets/wireguard.key
APPRELAY_APNS_SIGNING_KEY_HOST_FILE=/data/apprelay/secrets/apns.p8

APPRELAY_VPN_ADDRESS=10.77.0.1/24
APPRELAY_VPN_PORT=51820
APPRELAY_DEVICE_LIFETIME_SECONDS=604800

# production for TestFlight/App Store; sandbox for development builds.
APPRELAY_APNS_ENVIRONMENT=production
APPRELAY_APNS_KEY_ID=
APPRELAY_APNS_TEAM_ID=
APPRELAY_APNS_TOPIC=

# Optional: use a unique image tag per AppRelay deployment/environment.
APPRELAY_IMAGE=apprelay-server:local
