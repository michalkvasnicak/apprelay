{
  "name": "@apprelay/workspace",
  "private": true,
  "scripts": {
    "api:generate": "pnpm --filter @apprelay/mobile api:generate && pnpm --filter @brosoft/apprelay api:generate && pnpm --filter @apprelay/web api:generate",
    "api:check": "pnpm --filter @apprelay/mobile api:check && pnpm --filter @brosoft/apprelay api:check && pnpm --filter @apprelay/web api:check",
    "start": "pnpm --filter @apprelay/mobile start",
    "server": "pnpm --filter @apprelay/server start",
    "cli": "pnpm --filter @brosoft/apprelay start",
    "ios": "pnpm --filter @apprelay/mobile ios",
    "ios:simulator": "pnpm --filter @apprelay/mobile ios:simulator",
    "publish:ios:testflight": "pnpm --filter @apprelay/mobile publish:ios:testflight",
    "web:dev": "pnpm --filter @apprelay/web dev",
    "web:build": "pnpm --filter @apprelay/web build",
    "prepare": "husky",
    "lint": "pnpm -r lint",
    "format": "oxfmt --write . && pnpm --filter @apprelay/server format",
    "format:check": "oxfmt --check . && pnpm --filter @apprelay/server format:check",
    "typecheck": "pnpm api:check && pnpm -r typecheck"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "~6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,css,scss,less,html,vue,md,mdx,yaml,yml}": "oxfmt --write",
    "*.rs": "rustfmt --edition 2024"
  },
  "packageManager": "pnpm@10.33.2"
}
