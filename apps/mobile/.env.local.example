# Copy to .env.local for local development. Never put private keys here.

# URL scheme: apprelay-dev://pair?token=...
# with-env.mjs automatically sets EXPO_PUBLIC_APP_SCHEME=apprelay-dev; do not set it here.
# The Vite dev server opens this scheme. Rebuild the native app after scheme changes.

# Native signing settings, read by app.config.ts (not app JavaScript).
APPLE_TEAM_ID=
# Choose a reverse-DNS identifier owned by your Apple Developer team.
APPLE_BUNDLE_IDENTIFIER=com.example.apprelay.dev

# Public HTTPS API base URL, embedded by Expo. No credentials or private keys.
# The app posts to /v1/devices beneath this URL.
EXPO_PUBLIC_VPN_API_URL=https://api.example.com

# Direct WireGuard hostname or IP, without a scheme or port.
# Must bypass Cloudflare Tunnel / HTTP proxies (use DNS-only if on Cloudflare).
EXPO_PUBLIC_VPN_HOST=vpn.example.com
# Reachable UDP port; defaults to 51820 if omitted.
EXPO_PUBLIC_VPN_PORT=51820

# Shared app key, embedded in the app and extractable (not a private secret).
# Must exactly match the server's APPRELAY_API_KEY. Generate: openssl rand -hex 32
EXPO_PUBLIC_API_KEY=
