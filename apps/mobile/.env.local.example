# Copy to .env.local for local development. Never put private keys here.

# Native signing settings, read by app.config.ts (not app JavaScript).
APPLE_TEAM_ID=
# Choose a reverse-DNS identifier owned by your Apple Developer team.
APPLE_BUNDLE_IDENTIFIER=com.example.apprelay.dev

# Public HTTPS API base URL, embedded by Expo. No credentials or private keys.
# The app posts to /v1/devices beneath this URL.
EXPO_PUBLIC_VPN_API_URL=https://vpn.example.com

# Shared app key, embedded in the app and extractable (not a private secret).
# Must exactly match the server's APPRELAY_API_KEY. Generate: openssl rand -hex 32
EXPO_PUBLIC_API_KEY=
