# Copy to .env.local and supply your own values. Never put private keys here.

# Native signing settings, read by app.config.ts (not app JavaScript).
APPLE_TEAM_ID=
# Required for every build. Use different values per environment:
# local: sk.brosoft.apprelay.dev
# TestFlight (separate beta app): sk.brosoft.apprelay.beta
# production: sk.brosoft.apprelay
APPLE_BUNDLE_IDENTIFIER=sk.brosoft.apprelay.dev

# Public build-time settings, embedded by Expo.
# Replace the host and public key.
EXPO_PUBLIC_WG_SERVER_HOST=192.168.1.42
EXPO_PUBLIC_WG_SERVER_PORT=51820
EXPO_PUBLIC_WG_SERVER_PUBLIC_KEY=

# Server address INSIDE the tunnel, not its Wi-Fi endpoint.
# Only this single IPv4 address will be routed through WireGuard.
EXPO_PUBLIC_WG_SERVER_TUNNEL_IP=10.77.0.1
