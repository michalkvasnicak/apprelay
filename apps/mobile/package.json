{
  "name": "@apprelay/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "start": "node scripts/with-env.mjs local expo start",
    "ios": "node scripts/with-env.mjs local expo run:ios --device",
    "prebuild:ios": "node scripts/with-env.mjs local expo prebuild --platform ios",
    "publish:ios:testflight": "node scripts/publish-testflight-with-build-number.mjs",
    "lint": "oxlint --fix --deny-warnings --react-plugin .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/react-native": "^8.36.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-notifications": "~58.1.9",
    "expo-status-bar": "~58.0.5",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "openapi-typescript": "^7.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
