# Copy to .env.testflight for local release builds and TestFlight uploads.
# This file is independent of .env.local; supply every required value.

# URL scheme: apprelay://pair?token=...
# with-env.mjs automatically sets EXPO_PUBLIC_APP_SCHEME=apprelay; do not set it here.
# Production web builds open this scheme. Scheme changes require a new native build.

APPLE_TEAM_ID=
# Stable distribution identifier, shared with any future App Store release.
# Replace this example with an identifier owned by your Apple Developer team.
APPLE_BUNDLE_IDENTIFIER=com.example.apprelay

# Public HTTPS URL and extractable app key for the deployed server.
EXPO_PUBLIC_VPN_API_URL=https://api.example.com

# Direct WireGuard hostname or IP, without a scheme or port.
# Must bypass Cloudflare Tunnel / HTTP proxies (use DNS-only if on Cloudflare).
EXPO_PUBLIC_VPN_HOST=vpn.example.com
# Reachable UDP port; defaults to 51820 if omitted.
EXPO_PUBLIC_VPN_PORT=51820
# Must match the deployed server's APPRELAY_API_KEY (64 hexadecimal characters).
EXPO_PUBLIC_API_KEY=

# Last build number; publishing increments it and restores it on failure.
APPLE_BUILD_NUMBER=1

# Optional App Store Connect API authentication instead of your Xcode account.
# Supply all three together. Keep the private .p8 file outside the repository.
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER_ID=
# APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_YOUR_KEY_ID.p8

# Optional public error-reporting configuration. Empty DSN disables reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# Build-only artifact upload configuration. Required for TestFlight when a DSN is set.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
SENTRY_AUTH_TOKEN=
