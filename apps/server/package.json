{
  "name": "@apprelay/server",
  "private": true,
  "scripts": {
    "start": "cargo run",
    "start:release": "cargo run --release",
    "test:api": "node scripts/test-api.mjs",
    "vpn:agent": "cargo build --bin vpn-agent && sudo -E env PATH=\"$PATH\" ./target/debug/vpn-agent",
    "pairing:worker": "cargo run --bin pairing-worker",
    "notifications:worker": "cargo run --bin notification-worker",
    "install:worker": "cargo run --bin install-worker",
    "pairing:start": "cargo run --bin pair-device",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "typecheck": "cargo check --all-targets --all-features",
    "format": "cargo fmt",
    "format:check": "cargo fmt --check"
  }
}
