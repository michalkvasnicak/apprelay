# Optional hardware UDID supplied by the host. Never put Apple secrets in VITE_* variables.
# With no value, the UI uses a clearly marked placeholder and blocks device provisioning.
VITE_DEVICE_UDID=

# Optional public DSN. Empty disables Sentry; never put upload tokens in VITE_*.
# Reporting is enabled only in production builds (not the Vite dev server).
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Export SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT in the build
# environment when a DSN is configured. No organization/project defaults.
# Optionally export SENTRY_RELEASE (e.g. a git SHA) for deployment tracking.
