{
  "agent_before_settle": {
    "failFast": true,
    "maxRetries": 5,
    "checks": [
      {
        "name": "api: synchronized types",
        "type": "command",
        "command": "pnpm api:check",
        "inputs": [
          "apps/server/**/*.rs",
          "apps/server/Cargo.toml",
          "apps/server/Cargo.lock",
          "apps/mobile/src/api/schema.d.ts",
          "apps/mobile/scripts/generate-api.mjs",
          "apps/mobile/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "name": "server: lint",
        "type": "command",
        "command": "pnpm --filter @apprelay/server lint",
        "inputs": [
          "apps/server/**/*.rs",
          "apps/server/migrations/**/*.sql",
          "apps/server/Cargo.toml",
          "apps/server/Cargo.lock",
          "apps/server/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "name": "server: typecheck",
        "type": "command",
        "command": "pnpm --filter @apprelay/server typecheck",
        "inputs": [
          "apps/server/**/*.rs",
          "apps/server/migrations/**/*.sql",
          "apps/server/Cargo.toml",
          "apps/server/Cargo.lock",
          "apps/server/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "name": "server: API integration tests",
        "type": "command",
        "command": "pnpm --filter @apprelay/server test:api",
        "inputs": [
          "apps/server/**/*.rs",
          "apps/server/migrations/**/*.sql",
          "apps/server/scripts/test-api.mjs",
          "apps/server/Cargo.toml",
          "apps/server/Cargo.lock",
          "apps/server/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "name": "mobile: lint",
        "type": "command",
        "command": "pnpm --filter @apprelay/mobile lint",
        "inputs": [
          "apps/mobile/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
          "apps/mobile/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          ".oxlintrc.json"
        ]
      },
      {
        "name": "mobile: typecheck",
        "type": "command",
        "command": "pnpm --filter @apprelay/mobile typecheck",
        "inputs": [
          "apps/mobile/**/*.{ts,tsx,mts,cts}",
          "apps/mobile/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          "apps/mobile/**/tsconfig*.json"
        ]
      },
      {
        "name": "web: lint",
        "type": "command",
        "command": "pnpm --filter @apprelay/web lint",
        "inputs": [
          "apps/server/web/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
          "apps/server/web/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          ".oxlintrc.json"
        ]
      },
      {
        "name": "web: typecheck",
        "type": "command",
        "command": "pnpm --filter @apprelay/web typecheck",
        "inputs": [
          "apps/server/web/**/*.{ts,tsx,mts,cts}",
          "apps/server/web/**/tsconfig*.json",
          "apps/server/web/package.json",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      },
      {
        "name": "web: build",
        "type": "command",
        "command": "pnpm --filter @apprelay/web build",
        "inputs": [
          "apps/server/web/**/*.{ts,tsx,css,html,json}",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml"
        ]
      }
    ]
  }
}
